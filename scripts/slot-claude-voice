#!/bin/bash
# `slot claude voice` — v2.11: bidirectional voice control via ElevenLabs CAI + bridge.
#
# Architecture: see /Users/lukasz/.claude/plans/we-need-to-extend-synchronous-pond.md
#
# Summary:
#   - An ElevenLabs Conversational AI agent handles phone calls (inbound + outbound).
#   - A Python bridge on the slot (systemd, :8080 via Tailscale Funnel) exposes
#     4 HTTP tools to the CAI agent: get_claude_state, get_claude_last_output,
#     inject_message, watch_for_stop.
#   - Claude Code hooks append session events to SQLite so the bridge can answer
#     "how's it going?" in ~50 ms.
#   - Claude gets a `call_user` MCP tool (voice-outbound) for Claude-initiated calls.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"
FLOWSLOT_ROOT="$(dirname "$SCRIPT_DIR")"

# shellcheck source=lib/common.sh
source "$LIB_DIR/common.sh"
# shellcheck source=lib/claude-voice.sh
source "$LIB_DIR/claude-voice.sh"

show_help() {
  cat << EOF
Usage: slot claude voice <subcommand>

Bidirectional phone conversations with Claude Code via ElevenLabs CAI.
You can call Claude ("how's it going?", "what did it say?", "tell it to X"),
and Claude can call you ("call_user" MCP tool) when a task finishes.

Subcommands:
  enable         Install bridge service + Claude hooks + voice-outbound MCP on
                 the slot; configure Tailscale Funnel. Auto-cleans v2.10 (call-me)
                 artifacts. Prompts once for ElevenLabs credentials if missing.
  disable        Stop bridge, remove hooks, unregister MCP, Funnel off.
                 Keeps the bridge SQLite history for forensics.
  status         Show systemd state, Funnel URL, hook + MCP registration.
  logs [-f]      journalctl of flowslot-bridge.service (add -f to follow).
  agent-config   Print the ElevenLabs CAI agent config — system prompt and the
                 4 tool definitions, ready to paste into your ElevenLabs dashboard.
  test           Place an outbound test call via the voice-outbound MCP directly.

Prerequisites (one-time, per tailnet):
  - Enable Tailscale Funnel for this EC2 node in your tailnet ACL.
    'voice enable' surfaces the one-click URL if missing.

Prerequisites (per project, prompted by 'voice enable' if missing):
  - FLOWSLOT_ELEVENLABS_API_KEY      — from elevenlabs.io dashboard
  - FLOWSLOT_ELEVENLABS_AGENT_ID     — the CAI agent you create
  - FLOWSLOT_ELEVENLABS_PHONE_NUMBER_ID — phone number registered with ElevenLabs
  - FLOWSLOT_TWILIO_TO               — your phone number (E.164)
EOF
}

case "${1:-}" in
  ""|-h|--help) show_help; exit 0 ;;
esac

ACTION="$1"; shift || true
[ -n "${SLOT_REMOTE_HOST:-}" ] || die "SLOT_REMOTE_HOST not set (is .slotconfig loaded?)"

_resolve_active_slot() {
  local name
  if name="$(detect_slot_name 2>/dev/null)"; then
    echo "$name"; return 0
  fi
  name="$(ssh "$SLOT_REMOTE_HOST" "tmux ls 2>/dev/null | awk -F: '/^claude-/{print \$1; exit}' | sed 's/^claude-//'" 2>/dev/null || true)"
  [ -n "$name" ] && echo "$name" && return 0
  return 1
}

case "$ACTION" in
  # --------------------------------------------------------------------------
  enable)
    ACTIVE_SLOT="$(_resolve_active_slot)" || {
      log_warn "Could not auto-detect active slot. Will use whatever claude-* tmux session exists at call time."
      ACTIVE_SLOT=""
    }

    ensure_elevenlabs_configured || exit 1

    log_info "Cleaning up any v2.10 call-me artifacts on slot..."
    cleanup_v210_artifacts "$SLOT_REMOTE_HOST"

    ensure_python3_installed "$SLOT_REMOTE_HOST"

    log_info "Deploying bridge server + hooks..."
    install_bridge "$SLOT_REMOTE_HOST" "$FLOWSLOT_ROOT"

    log_info "Writing bridge env..."
    write_bridge_env "$SLOT_REMOTE_HOST" "$ACTIVE_SLOT"

    log_info "Installing systemd unit for bridge..."
    deploy_bridge_systemd "$SLOT_REMOTE_HOST" "$FLOWSLOT_ROOT"

    log_info "Registering Claude hooks (PreToolUse, PostToolUse, Stop, Notification)..."
    install_claude_hooks "$SLOT_REMOTE_HOST"

    log_info "Installing voice-outbound MCP on slot..."
    install_voice_outbound_mcp "$SLOT_REMOTE_HOST" "$FLOWSLOT_ROOT"

    log_info "Configuring Tailscale Funnel..."
    tailscale_funnel_enable "$SLOT_REMOTE_HOST" "$FLOWSLOT_BRIDGE_LOCAL_PORT" \
      || die "Failed to enable Tailscale Funnel. See the URL above to enable it on your tailnet."

    FQDN="$(get_tailscale_fqdn "$SLOT_REMOTE_HOST")"
    [ -n "$FQDN" ] || die "Could not determine Tailscale FQDN."
    FUNNEL_URL="https://${FQDN}"

    ssh "$SLOT_REMOTE_HOST" 'date -u +%FT%TZ > "$HOME/.flowslot/voice-ready"'

    echo ""
    success "Voice chat enabled."
    echo ""
    echo "  Active slot:   ${ACTIVE_SLOT:-<auto-detected at call time>}"
    echo "  Funnel URL:    ${FUNNEL_URL}"
    echo "  Agent ID:      ${FLOWSLOT_ELEVENLABS_AGENT_ID}"
    echo ""
    echo "Next: run 'slot claude voice agent-config' to get the system prompt and"
    echo "      tool JSONs to paste into your ElevenLabs agent."
    ;;

  # --------------------------------------------------------------------------
  disable)
    log_info "Stopping bridge service..."
    bridge_service_stop "$SLOT_REMOTE_HOST"

    log_info "Removing Claude hooks..."
    uninstall_claude_hooks "$SLOT_REMOTE_HOST"

    log_info "Unregistering voice-outbound MCP..."
    uninstall_voice_outbound_mcp "$SLOT_REMOTE_HOST"

    log_info "Disabling Tailscale Funnel..."
    tailscale_funnel_disable "$SLOT_REMOTE_HOST"

    ssh "$SLOT_REMOTE_HOST" 'rm -f "$HOME/.flowslot/voice-ready"' 2>/dev/null || true

    success "Voice chat disabled. Bridge source and DB preserved under ~/.flowslot/."
    ;;

  # --------------------------------------------------------------------------
  status)
    READY="no"
    ssh "$SLOT_REMOTE_HOST" 'test -f "$HOME/.flowslot/voice-ready"' 2>/dev/null && READY="yes"
    ACTIVE_BRIDGE="no"
    bridge_service_is_active "$SLOT_REMOTE_HOST" && ACTIVE_BRIDGE="yes"
    HOOKS_PRESENT="$(ssh "$SLOT_REMOTE_HOST" 'jq -r ".hooks.PreToolUse[0].hooks[0].command // empty" "$HOME/.claude/settings.json" 2>/dev/null' 2>/dev/null || true)"
    MCP_PRESENT="$(ssh "$SLOT_REMOTE_HOST" 'PATH=$HOME/.local/bin:$PATH claude mcp list 2>/dev/null | grep -E "^voice-outbound[: ]" | head -1' 2>/dev/null || true)"
    FQDN="$(get_tailscale_fqdn "$SLOT_REMOTE_HOST")"
    FUNNEL_OUT="$(ssh "$SLOT_REMOTE_HOST" 'tailscale funnel status 2>/dev/null' 2>/dev/null | head -20)"

    echo "Voice status for $SLOT_REMOTE_HOST"
    echo "  Bootstrap marker:   $READY"
    echo "  Bridge service:     $ACTIVE_BRIDGE"
    echo "  Claude hooks:       $([ -n "$HOOKS_PRESENT" ] && echo yes || echo no)"
    echo "  voice-outbound MCP: $([ -n "$MCP_PRESENT" ] && echo yes || echo no)"
    [ -n "$FQDN" ] && echo "  Funnel URL:         https://${FQDN}"
    echo ""
    if [ -n "$FUNNEL_OUT" ]; then
      echo "$FUNNEL_OUT"
    else
      echo "  (Funnel inactive)"
    fi
    ;;

  # --------------------------------------------------------------------------
  logs)
    FOLLOW=0
    for arg in "$@"; do
      case "$arg" in
        -f|--follow) FOLLOW=1 ;;
      esac
    done
    if [ $FOLLOW -eq 1 ]; then
      exec ssh -t "$SLOT_REMOTE_HOST" "sudo journalctl -u $FLOWSLOT_BRIDGE_SERVICE -f -n 50"
    else
      exec ssh "$SLOT_REMOTE_HOST" "sudo journalctl -u $FLOWSLOT_BRIDGE_SERVICE -n 100 --no-pager"
    fi
    ;;

  # --------------------------------------------------------------------------
  agent-config)
    FQDN="$(get_tailscale_fqdn "$SLOT_REMOTE_HOST")"
    [ -n "$FQDN" ] || die "Could not determine Funnel URL; is voice enabled?"
    [ -n "${FLOWSLOT_BRIDGE_HMAC_SECRET:-}" ] || die "FLOWSLOT_BRIDGE_HMAC_SECRET not set — run 'slot claude voice enable' first."
    print_agent_config "$FLOWSLOT_ROOT" "https://${FQDN}" "$FLOWSLOT_BRIDGE_HMAC_SECRET"
    ;;

  # --------------------------------------------------------------------------
  test)
    log_info "Placing a test outbound call via voice-outbound MCP..."
    ssh "$SLOT_REMOTE_HOST" bash << 'REMOTE_TEST'
      set -e
      printf '%s\n' \
        '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"flowslot-test","version":"1"}}}' \
        '{"jsonrpc":"2.0","method":"notifications/initialized","params":{}}' \
        '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"call_user","arguments":{"message":"This is a flowslot voice test. If you hear me, the pipeline works. Hang up when you are ready.","reason":"done"}}}' \
        | "$HOME/.flowslot/bin/voice-outbound-mcp" 2>/dev/null | tail -3
REMOTE_TEST
    echo ""
    log_info "If the call didn't ring, check 'slot claude voice logs' and 'slot claude voice status'."
    ;;

  # --------------------------------------------------------------------------
  *)
    log_error "Unknown subcommand: $ACTION"
    echo ""
    show_help
    exit 1
    ;;
esac
