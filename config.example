# Flowslot Configuration
# Copy this file to config.local and fill in your values:
#   cp config.example config.local
#
# config.local is gitignored - your secrets stay safe

# =============================================================================
# REQUIRED: Tailscale auth key for joining devices to tailnet
# Get from: https://login.tailscale.com/admin/settings/keys
# Create a "Reusable" auth key
# =============================================================================
export TAILSCALE_AUTH_KEY="tskey-auth-XXXXXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# =============================================================================
# OPTIONAL: Tailscale API key for automatic Split DNS updates
# Get from: https://login.tailscale.com/admin/settings/keys
# Create an "API access token"
# =============================================================================
export TS_API_KEY="tskey-api-XXXXXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Your tailnet name (found in Tailscale admin console URL)
export TS_TAILNET="your-tailnet.ts.net"

# Domain for Split DNS (default: flowslot.cc)
# WARNING: flowslot.cc is also the project website (https://flowslot.cc) which uses HTTPS.
# If you've visited it, your browser cached HSTS and will force HTTPS on dev URLs.
# Recommended: Use your own domain (e.g., flowslot.dev, dev.yourcompany.com)
export TS_SPLIT_DOMAIN="flowslot.cc"

# =============================================================================
# OPTIONAL: AWS SSH key name
# The name of an EC2 key pair for SSH access
# =============================================================================
export AWS_KEY_NAME="flowslot-dev"

# =============================================================================
# OPTIONAL: `slot claude` — run Claude Code on slots with real phone-call
# notifications via Twilio Voice. When Claude finishes a task or asks for your
# input, your phone rings with a TwiML-spoken message (works on locked phones,
# bypasses Do Not Disturb if you set it as an emergency contact).
#
# Per-project values are written to .slotconfig by `slot self init`; the ones
# below are documented here for reference / manual configuration.
#
# FLOWSLOT_TWILIO_ACCOUNT_SID  Your Twilio Account SID (starts with "AC…"),
#                              from https://console.twilio.com/.
# FLOWSLOT_TWILIO_AUTH_TOKEN   Your Twilio Auth Token (same page).
# FLOWSLOT_TWILIO_FROM         Your Twilio phone number in E.164 (e.g. +15551234567).
#                              Trial accounts get one free; Console → Phone Numbers.
# FLOWSLOT_TWILIO_TO           Your personal phone number in E.164 (the one that rings).
#                              Trial accounts must verify this number first (Console →
#                              Phone Numbers → Verified Caller IDs).
# FLOWSLOT_TWILIO_VOICE        Optional TwiML voice (default: "alice"). Examples:
#                              "Polly.Matthew-Neural", "Polly.Joanna-Neural".
# SLOT_CLAUDE_DEFAULT          remote (default) or local — flip `slot claude` default.
#
# Cost: ~$1/mo for a Twilio number + ~$0.013 per call. Free trial gives $15 credit.
# =============================================================================

