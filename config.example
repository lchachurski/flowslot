# Flowslot Configuration
# Copy this file to config.local and fill in your values:
#   cp config.example config.local
#
# config.local is gitignored - your secrets stay safe

# =============================================================================
# REQUIRED: Tailscale auth key for joining devices to tailnet
# Get from: https://login.tailscale.com/admin/settings/keys
# Create a "Reusable" auth key
# =============================================================================
export TAILSCALE_AUTH_KEY="tskey-auth-XXXXXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# =============================================================================
# OPTIONAL: Tailscale API key for automatic Split DNS updates
# Get from: https://login.tailscale.com/admin/settings/keys
# Create an "API access token"
# =============================================================================
export TS_API_KEY="tskey-api-XXXXXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Your tailnet name (found in Tailscale admin console URL)
export TS_TAILNET="your-tailnet.ts.net"

# Domain for Split DNS (default: flowslot.cc)
# WARNING: flowslot.cc is also the project website (https://flowslot.cc) which uses HTTPS.
# If you've visited it, your browser cached HSTS and will force HTTPS on dev URLs.
# Recommended: Use your own domain (e.g., flowslot.dev, dev.yourcompany.com)
export TS_SPLIT_DOMAIN="flowslot.cc"

# =============================================================================
# OPTIONAL: AWS SSH key name
# The name of an EC2 key pair for SSH access
# =============================================================================
export AWS_KEY_NAME="flowslot-dev"

# =============================================================================
# OPTIONAL: `slot create` sets up a real git origin on each slot so Claude Code
# (running on the slot) can commit and push. Requires a GitHub token.
#
# FLOWSLOT_GITHUB_TOKEN    Fine-grained GitHub Personal Access Token with
#                          `Contents: Read and write` on the target repo only.
#                          Create at https://github.com/settings/personal-access-tokens/new
#                          Store per-project in .slotconfig (slot self init prompts for it).
#                          The EC2 stores the token in ~/.git-credentials (0600)
#                          via the `store` credential helper; any slot inherits it.
# FLOWSLOT_GIT_USER_NAME   Commit author name on slots (default: flowslot-bot).
# FLOWSLOT_GIT_USER_EMAIL  Commit author email (default: flowslot-bot@flowslot.cc).
# =============================================================================

# =============================================================================
# OPTIONAL: `slot claude voice` — bidirectional phone conversations with Claude
# Code on a slot, via ElevenLabs Conversational AI.
#
# Architecture: a Python bridge on the slot (systemd) exposes 4 HTTP tools
# (get_claude_state, get_claude_last_output, inject_message, watch_for_stop)
# reached through Tailscale Funnel. The ElevenLabs CAI agent uses those tools
# to read Claude's session state and relay messages. Claude also gets a
# `call_user` MCP tool (voice-outbound) that dials via ElevenLabs.
#
# Per-project values are written to .slotconfig by `slot self init` or the
# first run of `slot claude voice enable`.
#
# FLOWSLOT_ELEVENLABS_API_KEY        Your ElevenLabs API key (Profile → API keys).
# FLOWSLOT_ELEVENLABS_AGENT_ID       ID of the Conversational AI agent you created
#                                    in the ElevenLabs dashboard.
# FLOWSLOT_ELEVENLABS_PHONE_NUMBER_ID Phone number ID registered with ElevenLabs
#                                    (their own or a Twilio number imported).
# FLOWSLOT_TWILIO_TO                 Your personal phone number in E.164
#                                    (the one that rings).
# FLOWSLOT_BRIDGE_HMAC_SECRET        Auto-generated on first 'voice enable'.
#                                    Used to sign tool webhooks from CAI to the
#                                    bridge. Header: X-Flowslot-Signature.
# SLOT_CLAUDE_DEFAULT                remote (default) or local — flip `slot claude`.
# SLOT_CLAUDE_MODEL                  Model passed to `claude --model`. Accepts an
#                                    alias (e.g. 'opus', 'sonnet', 'haiku') or a
#                                    full model ID (e.g. 'claude-sonnet-4-6').
#                                    Unset = Claude Code CLI default. Override
#                                    per-invocation with `slot claude --model <id>`.
#
# One-time: enable Tailscale Funnel for the EC2 machine in your tailnet ACL
# (https://login.tailscale.com/admin/acls). 'voice enable' prints a one-click
# URL if it's not yet enabled.
#
# Cost: ElevenLabs CAI ~$0.10/minute conversational; Tailscale Funnel free on
# Personal and Starter plans.
# =============================================================================

